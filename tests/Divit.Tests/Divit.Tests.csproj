<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests run on .NET Framework 4.8 (through netstandard2.0) and on .NET 10. The Open XML SDK validator lives only here. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Part of the framework; .NET Framework only needs it named to open the saved zip. -->
    <Reference Include="System.IO.Compression" />
    <!-- Draws the photo-like demo images (JPEG, GIF) of the gallery; the library itself never uses it. -->
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Divit\Divit.csproj" />
  </ItemGroup>
</Project>
